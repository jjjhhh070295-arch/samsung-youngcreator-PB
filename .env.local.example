# 이 파일을 복사해 .env.local 로 만들고 키를 채우세요.
# 키를 비워두면 해당 기능 호출 시 안내 메시지만 뜨고 나머지는 정상 동작합니다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# AI Market Intelligence: research-only synthesis (no Claude fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
OPENAI_API_KEY=

# Optional server-side key for current FRED observations in deployed environments.
FRED_API_KEY=

# ── 부동산 시세 조회 (고객 상세 → 기본 정보 → 부동산 자산) ──
# DATA_GO_KR_SERVICE_KEY: data.go.kr 국토교통부 아파트 실거래가 발급키. 이게 없으면
#   "부동산 추가" 조회가 건너뛰어지고 직접 입력만 가능하다.
DATA_GO_KR_SERVICE_KEY=
# REB_INDEX_SERVICE_KEY: KOSIS 부동산가격지수 발급키. 과거 거래가를 현재 시점으로
#   보정하는 데만 쓴다. 없어도 조회는 되고 시점보정만 생략된다.
REB_INDEX_SERVICE_KEY=
# MOLIT_APT_TRADE_ENDPOINT: 실거래가 엔드포인트 재정의용. 보통은 비워 둘 것 —
#   코드에 정상 기본값이 있고, 여기에 URL 이 아닌 값이 들어가면 무시된다.
MOLIT_APT_TRADE_ENDPOINT=

# ── 모닝 브리핑 고객 메일 발송 (/api/briefing/send) ──
# 아래 조건이 하나라도 어긋나면 한 통도 나가지 않는다. 실패 코드는 응답의 code 필드로 온다.
#
# [필수] RESEND_API_KEY: Resend 발송 API 키. 없으면 발송이 code:"NO_EMAIL_KEY" 로 막힌다.
RESEND_API_KEY=
# [필수] BRIEFING_CRON_SECRET: /api/briefing/send 호출 인증(Authorization: Bearer ...).
#   없으면 401. fail-closed 라 값이 없으면 크론도 수동 호출도 전부 거부된다.
#   32자 이상 랜덤 권장.
#
#   이름이 BRIEFING_ 접두사인 이유: Vercel 이 CRON_SECRET 을 예약어로 막아 프로젝트
#   환경변수로 등록할 수 없다. 코드는 BRIEFING_CRON_SECRET 을 먼저 읽고, 없으면 옛 이름
#   CRON_SECRET 으로 폴백한다(lib/cronAuth.ts 의 cronSecret). 그래서 로컬 .env.local 이
#   아직 옛 이름이어도 그대로 동작한다. 폴백은 이행용이므로, 로컬·Vercel 양쪽이 새
#   이름으로 옮겨간 뒤에 걷어낸다.
#
#   UNSUBSCRIBE_SECRET 이 비어 있을 때 수신거부 서명키로도 폴백된다(아래 참고).
BRIEFING_CRON_SECRET=
# [이행용] CRON_SECRET: 옛 이름. 위 값이 없을 때만 쓰인다. Vercel 에는 등록할 수 없고
#   로컬 .env.local 에서만 유효하다. 새 이름으로 옮긴 뒤 지워라.
CRON_SECRET=
# [권장] UNSUBSCRIBE_SECRET: 수신거부 링크 HMAC 서명키.
#   비우면 크론 시크릿으로 폴백한다 — 우선순위는
#     UNSUBSCRIBE_SECRET → BRIEFING_CRON_SECRET → CRON_SECRET
#   셋 다 없으면 발송이 code:"NO_UNSUBSCRIBE_SECRET" 로 막힌다 —
#   수신거부 수단 없이는 보내지 않는다는 원칙이라 의도적으로 실패시킨다.
#   인증키와 서명키를 분리해 두면 한쪽을 교체해도 다른 쪽이 영향받지 않는다.
#
#   ⚠️ 폴백으로 서명하던 중에 그 값이 바뀌면 이미 발송된 메일의 수신거부 링크가 전부
#      무효가 된다. CRON_SECRET → BRIEFING_CRON_SECRET 으로 옮길 때는 같은 값을 넣어라.
UNSUBSCRIBE_SECRET=
# [권장] BRIEFING_FROM_EMAIL: 발신 주소. Resend 에서 도메인 인증을 마친 주소여야 한다.
#   비우면 코드 기본값으로 나가고, 미인증 도메인이면 수신측에서 스팸 처리되거나 반송된다.
#   인증 여부는 발송 응답의 verifiedSenderDomain 값으로 확인할 수 있다.
BRIEFING_FROM_EMAIL=
# [권장] BRIEFING_PUBLIC_URL: 메일 안 수신거부 링크에 쓸 절대 URL(예: https://example.com).
#   비우면 NEXT_PUBLIC_APP_URL → Vercel 자동 URL 순으로 폴백하는데, 그 경우 프리뷰 배포
#   URL 이 고객 메일에 박힐 수 있다. 운영에서는 반드시 채울 것.
BRIEFING_PUBLIC_URL=
# [선택] BRIEFING_SUBJECT_PREFIX: 메일 제목 접두사. 비우면 접두사 없이 나간다.
BRIEFING_SUBJECT_PREFIX=

# ── 고객 공유 링크 (/view/<token>, PB 계정 없이 고객 본인 화면만) ──
# [필수] CLIENT_VIEW_SECRET: 공유 링크 서명키(HMAC-SHA256). 32자 이상 랜덤.
#   폴백을 두지 않는다. UNSUBSCRIBE_SECRET·CRON_SECRET 을 재사용하면 이미 발송된
#   메일의 수신거부 링크가 그대로 고객화면 열쇠가 되기 때문이다.
#   없으면 링크 발급·열람이 503 이고 PB 화면의 생성 버튼이 비활성된다.
#   ⚠️ 값을 바꾸면 이미 나눠 준 링크가 전부 무효가 된다(무상태 토큰이라 개별 폐기 불가).
CLIENT_VIEW_SECRET=
# [필수] SUPABASE_SERVICE_ROLE_KEY: 공유 링크 라우트가 RLS 를 우회해 해당 고객 1건만
#   읽는 데 쓴다. Supabase 대시보드 → Project Settings → API → service_role 키.
#   ⚠️ 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것 — 붙이면 브라우저 번들에 실린다.
#   비어 있거나 JWT 형태(점 2개)가 아니면 미설정으로 보고 503 을 돌려준다.
SUPABASE_SERVICE_ROLE_KEY=
# [권장] BRIEFING_PUBLIC_URL 또는 NEXT_PUBLIC_APP_URL: 공유 링크의 절대 URL 기준.
#   위 모닝 브리핑 항목과 같은 값을 함께 쓴다. 없으면 Vercel 자동 URL → 요청 origin 순.
