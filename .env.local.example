# KIS Open API (server only — never NEXT_PUBLIC_)
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=
KIS_CONDITION_SEQ=
KIS_LIVE_TRADING_ENABLED=false
KIS_MAX_ORDER_WON=10000000
KIS_MAX_DAILY_ORDER_WON=50000000

# Demo: KIS 키 없어도 스크리닝·게이트 UI 전체 동작 (기본 자동 ON when keys missing)
TRADING_DEMO_MODE=true

# Regime / strategy / auto-trade
REGIME_INDEX_SYMBOL=^KS11
STRATEGY_ALLOCATED_WON=1000000
STRATEGY_SCHEDULER_ENABLED=true
STRATEGY_INTERVAL_MS=60000
